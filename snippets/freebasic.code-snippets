{
  "Function": {
    "prefix": "function",
    "body": [
      "Function ${1:name}(${2}) As ${3:Integer}",
      "    ${0}",
      "End Function"
    ],
    "description": "Function block"
  },
  "Sub": {
    "prefix": "sub",
    "body": [
      "Sub ${1:name}(${2})",
      "    ${0}",
      "End Sub"
    ],
    "description": "Sub block"
  },
  "If": {
    "prefix": "if",
    "body": [
      "If ${1:condition} Then",
      "    ${0}",
      "End If"
    ],
    "description": "If block"
  },
  "For": {
    "prefix": "for",
    "body": [
      "For ${1:i} = ${2:0} To ${3:10}",
      "    ${0}",
      "Next ${1:i}"
    ],
    "description": "For loop"
  },
  "Select Case": {
    "prefix": "select",
    "body": [
      "Select Case ${1:expr}",
      "Case ${2:value}",
      "    ${0}",
      "Case Else",
      "End Select"
    ],
    "description": "Select Case block"
  },
  "Select Case As Const": {
    "prefix": "selectconst",
    "body": [
      "Select Case As Const ${1:expr}",
      "Case ${2:value}",
      "    ${0}",
      "Case Else",
      "End Select"
    ],
    "description": "Select Case As Const block"
  },
  "Type": {
    "prefix": "type",
    "body": [
      "Type ${1:Name}",
      "    ${0}",
      "End Type"
    ],
    "description": "Type block"
  },
  "Type With Constructor": {
    "prefix": "typeconstructor",
    "body": [
      "Type ${1:Name}",
      "    Declare Constructor(${2})",
      "    Declare Destructor()",
      "    ${3:value} As ${4:Integer}",
      "End Type",
      "",
      "Constructor ${1:Name}(${2})",
      "    ${0}",
      "End Constructor",
      "",
      "Destructor ${1:Name}()",
      "End Destructor"
    ],
    "description": "Type declaration with constructor and destructor implementations"
  },
  "Property Pair": {
    "prefix": "propertypair",
    "body": [
      "Type ${1:TypeName}",
      "Private:",
      "    ${2:storedValue} As ${3:Integer}",
      "Public:",
      "    Declare Property ${4:value}(ByVal newValue As ${3:Integer})",
      "    Declare Property ${4:value}() As ${3:Integer}",
      "End Type",
      "",
      "Property ${1:TypeName}.${4:value}(ByVal newValue As ${3:Integer})",
      "    ${2:storedValue} = newValue",
      "End Property",
      "",
      "Property ${1:TypeName}.${4:value}() As ${3:Integer}",
      "    Return ${2:storedValue}",
      "End Property",
      "${0}"
    ],
    "description": "Matching property setter and getter declarations and implementations"
  },
  "Enum": {
    "prefix": "enum",
    "body": [
      "Enum ${1:Name}",
      "    ${2:FirstValue} = 0",
      "    ${3:SecondValue}",
      "End Enum",
      "${0}"
    ],
    "description": "Named enum block"
  },
  "Namespace": {
    "prefix": "namespace",
    "body": [
      "Namespace ${1:Name}",
      "",
      "    ${0}",
      "",
      "End Namespace"
    ],
    "description": "Namespace block"
  },
  "Include Once": {
    "prefix": "includeonce",
    "body": [
      "#include once \"${1:header.bi}\"",
      "${0}"
    ],
    "description": "Include a FreeBASIC header once"
  },
  "Conditional Compilation": {
    "prefix": "ifdef",
    "body": [
      "#ifdef ${1:__FB_WIN32__}",
      "    ${0}",
      "#else",
      "",
      "#endif"
    ],
    "description": "Conditional compilation block"
  },
  "Option Explicit (Legacy Dialects)": {
    "prefix": "optionexplicit",
    "body": [
      "Option Explicit",
      "${0}"
    ],
    "description": "Require explicit declarations when compiling with -lang fblite or -lang qb"
  },
  "On Error": {
    "prefix": "onerror",
    "body": [
      "On Error Goto ${1:error_handler}",
      "${0}",
      "",
      "${1:error_handler}:",
      "    Resume Next"
    ],
    "description": "Install a simple error handler with Resume Next recovery"
  },
  "Resume Next": {
    "prefix": "resumenext",
    "body": [
      "Resume Next"
    ],
    "description": "Resume execution at the next statement from an error handler"
  },
  "Line Input": {
    "prefix": "lineinput",
    "body": [
      "Dim As String ${1:text}",
      "Line Input \"${2:Prompt: }\"; ${1:text}",
      "${0}"
    ],
    "description": "Read a full line from the console"
  },
  "Line Input File": {
    "prefix": "lineinputfile",
    "body": [
      "Dim As Integer ${1:file_num} = FreeFile()",
      "Dim As String ${2:text}",
      "Open \"${3:data.txt}\" For Input As #${1:file_num}",
      "Line Input #${1:file_num}, ${2:text}",
      "Close #${1:file_num}",
      "${0}"
    ],
    "description": "Read a full line from an open file"
  },
  "COM Port Status": {
    "prefix": "comstatus",
    "body": [
      "#include once \"fbcom.bi\"",
      "Using FB",
      "",
      "Dim As String ${1:port_spec} = \"${2:COM1:9600,N,8,1}\"",
      "Dim As Integer ${3:file_number} = FreeFile()",
      "Open Com ${1:port_spec} For Binary Access Read Write As #${3:file_number}",
      "If( Err <> 0 ) Then",
      "    Print \"Could not open \"; ${1:port_spec}; \". Runtime error \"; Err; \".\"",
      "Else",
      "    Dim As ComStatus ${4:status}",
      "    If( ComGetStatus(${3:file_number}, ${4:status}) = 0 ) Then",
      "        ${0}",
      "    End If",
      "    Close #${3:file_number}",
      "End If"
    ],
    "description": "Open a serial port and query its portable fbcom status"
  },
  "ScreenRes": {
    "prefix": "screenres",
    "body": [
      "ScreenRes ${1:640}, ${2:480}, ${3:32}",
      "${0}"
    ],
    "description": "Open a graphics screen"
  },
  "Draw String": {
    "prefix": "drawstring",
    "body": [
      "Draw String (${1:x}, ${2:y}), \"${3:Hello world}\", ${4:RGB(255, 255, 255)}",
      "${0}"
    ],
    "description": "Draw text in a graphics context"
  },
  "Palette Using": {
    "prefix": "paletteusing",
    "body": [
      "Dim Shared As UInteger ${1:palette}(0 To ${2:255})",
      "Palette Using ${1:palette}(0)",
      "${0}"
    ],
    "description": "Apply a palette array to an 8-bit graphics mode"
  },
  "ImageCreate": {
    "prefix": "imagecreate",
    "body": [
      "Dim As Any Ptr ${1:image} = ImageCreate(${2:128}, ${3:128}, ${4:RGB(0, 0, 0)})",
      "If( ${1:image} <> 0 ) Then",
      "    ${0}",
      "    ImageDestroy(${1:image})",
      "End If"
    ],
    "description": "Create and clean up an FB.IMAGE buffer"
  },
  "ImageInfo": {
    "prefix": "imageinfo",
    "body": [
      "Dim As Any Ptr ${1:image} = ImageCreate(${2:45}, ${3:37})",
      "Dim As Integer ${4:w}, ${5:h}, ${6:bpp}, ${7:pitch}, ${8:size}",
      "Dim As Byte Ptr ${9:pixdata}",
      "Dim As Integer ${10:result}",
      "",
      "If( ${1:image} = 0 ) Then",
      "    Print \"ImageCreate failed\"",
      "Else",
      "    ${10:result} = ImageInfo(${1:image}, ${4:w}, ${5:h}, ${6:bpp}, ${7:pitch}, ${9:pixdata}, ${8:size})",
      "    If( ${10:result} = 0 ) Then",
      "        ${0}",
      "    End If",
      "    ImageDestroy(${1:image})",
      "End If"
    ],
    "description": "Query FB.IMAGE metadata with ImageInfo"
  },
  "Gfx3 GPU Surface": {
    "prefix": "gfx3surface",
    "body": [
      "#include once \"fbgfx3.bi\"",
      "Using FB",
      "",
      "If( ScreenRes(${1:640}, ${2:480}, 32) <> 0 ) Then End 1",
      "",
      "Dim As Any Ptr ${3:surface} = Gfx3SurfaceCreate(${4:256}, ${5:256}, 32)",
      "If( ${3:surface} = 0 ) Then",
      "    Screen 0",
      "    End 1",
      "End If",
      "",
      "If( Gfx3SurfaceClear(${3:surface}, ${6:RGB(20, 30, 40)}) = 0 ) Then",
      "    ${0}",
      "End If",
      "",
      "Gfx3SurfaceDestroy(${3:surface})",
      "Screen 0"
    ],
    "description": "Create, use, and destroy an opt-in gfxlib3 GPU surface"
  },
  "ScreenLock": {
    "prefix": "screenlock",
    "body": [
      "ScreenLock",
      "    ${0}",
      "ScreenUnlock"
    ],
    "description": "Lock the graphics framebuffer for direct updates"
  },
  "ThreadCreate": {
    "prefix": "threadcreate",
    "body": [
      "Function ${1:worker}(ByVal ${2:userdata} As Any Ptr) As Any Ptr",
      "    ${0}",
      "    Return 0",
      "End Function",
      "",
      "Dim As Any Ptr ${3:thread_handle} = ThreadCreate(@${1:worker}, ${4:0})",
      "If( ${3:thread_handle} <> 0 ) Then",
      "    ThreadWait(${3:thread_handle})",
      "End If"
    ],
    "description": "Create a worker thread and wait for it to finish"
  },
  "Mutex Thread Pair": {
    "prefix": "mutexthread",
    "body": [
      "Declare Sub ${1:worker}(ByVal ${2:param} As Any Ptr)",
      "",
      "Dim Shared As Any Ptr ${3:lock}",
      "Dim As Any Ptr ${4:thread_id}",
      "",
      "${3:lock} = MutexCreate()",
      "If( ${3:lock} = 0 ) Then",
      "    Print \"Error creating mutex\"",
      "    End 1",
      "End If",
      "",
      "${4:thread_id} = ThreadCreate(@${1:worker}, 0)",
      "If( ${4:thread_id} <> 0 ) Then",
      "    ThreadWait(${4:thread_id})",
      "End If",
      "MutexDestroy(${3:lock})",
      "",
      "Sub ${1:worker}(ByVal ${2:param} As Any Ptr)",
      "    MutexLock ${3:lock}",
      "    ${0}",
      "    MutexUnlock ${3:lock}",
      "End Sub"
    ],
    "description": "Create a mutex and coordinate a worker thread with it"
  },
  "ScreenEvent Loop": {
    "prefix": "screenevent",
    "body": [
      "#include \"fbgfx.bi\"",
      "Using FB",
      "",
      "ScreenRes ${1:640}, ${2:480}, ${3:32}",
      "",
      "Dim As EVENT ${4:e}",
      "Do",
      "    While( ScreenEvent(@${4:e}) <> 0 )",
      "        Select Case As Const ${4:e}.type",
      "        Case EVENT_KEY_PRESS",
      "            ${0}",
      "        Case EVENT_WINDOW_CLOSE",
      "            Exit Do",
      "        End Select",
      "    Wend",
      "",
      "    Sleep 50, 1",
      "Loop"
    ],
    "description": "Poll the graphics event queue with ScreenEvent"
  },
  "GetMouse": {
    "prefix": "getmouse",
    "body": [
      "Dim As Integer ${1:x}, ${2:y}, ${3:z}, ${4:buttons}",
      "GetMouse ${1:x}, ${2:y}, ${3:z}, ${4:buttons}",
      "If( ${1:x} <> -1 ) Then",
      "    ${0}",
      "End If"
    ],
    "description": "Read mouse position, wheel, and button state"
  },
  "GetTouch Contacts": {
    "prefix": "gettouch",
    "body": [
      "Dim As Integer ${1:contact_count} = GetTouchCount()",
      "For ${2:index} As Integer = 0 To ${1:contact_count} - 1",
      "    Dim As Integer ${3:x}, ${4:y}, ${5:contact_id}",
      "    If( GetTouch(${2:index}, ${3:x}, ${4:y}, ${5:contact_id}) = 0 ) Then",
      "        ${0}",
      "    End If",
      "Next ${2:index}"
    ],
    "description": "Enumerate the current touch contacts with GetTouchCount and GetTouch"
  },
  "GetXPad State": {
    "prefix": "getxpad",
    "body": [
      "#include once \"fbgfx.bi\"",
      "Using FB",
      "",
      "Dim As Integer ${1:buttons}, ${2:dpad}",
      "Dim As Single ${3:left_x}, ${4:left_y}, ${5:right_x}, ${6:right_y}",
      "Dim As Single ${7:left_trigger}, ${8:right_trigger}",
      "Dim As Long ${9:status}",
      "",
      "${9:status} = GetXPad(${10:0}, ${1:buttons}, ${3:left_x}, ${4:left_y}, _",
      "    ${5:right_x}, ${6:right_y}, ${7:left_trigger}, ${8:right_trigger}, ${2:dpad})",
      "If( ${9:status} = XPAD_STATUS_CONNECTED ) Then",
      "    ${0}",
      "End If"
    ],
    "description": "Read buttons, sticks, triggers, and d-pad state from an Xbox-style controller"
  },
  "SetMouse": {
    "prefix": "setmouse",
    "body": [
      "SetMouse ${1:200}, ${2:150}, ${3:1}",
      "${0}"
    ],
    "description": "Set mouse position and visibility"
  },
  "MultiKey Loop": {
    "prefix": "multikey",
    "body": [
      "Do",
      "    If MultiKey(${1:SC_ESCAPE}) Then Exit Do",
      "    ${0}",
      "Loop"
    ],
    "description": "Poll keyboard state with MultiKey"
  },
  "Open TCP Client": {
    "prefix": "opentcp",
    "body": [
      "Dim As Integer ${1:file_num} = FreeFile()",
      "If( OPEN TCP( \"host=${2:127.0.0.1},port=${3:8080}\" As #${1:file_num} ) <> 0 ) Then",
      "    Print \"OPEN TCP failed, ERR=\"; Err",
      "Else",
      "    ${0}",
      "End If"
    ],
    "description": "Open a TCP client connection with FreeBASIC's OPEN TCP syntax"
  },
  "HTTP GET TCP": {
    "prefix": "httpget",
    "body": [
      "Dim As Integer ${1:file_num} = FreeFile()",
      "If( OPEN TCP( \"host=${2:example.com},port=${3:80}\" As #${1:file_num} ) <> 0 ) Then",
      "    Print \"OPEN TCP failed, ERR=\"; Err",
      "Else",
      "    Print #${1:file_num}, \"GET ${4:/} HTTP/1.0\"",
      "    Print #${1:file_num}, \"Host: ${2:example.com}\"",
      "    Print #${1:file_num},",
      "    While( EOF(${1:file_num}) = 0 )",
      "        Line Input #${1:file_num}, ${5:line_text}",
      "        Print ${5:line_text}",
      "    Wend",
      "    Close #${1:file_num}",
      "    ${0}",
      "End If"
    ],
    "description": "Open a TCP connection and issue a simple HTTP GET request"
  },
  "Open TCP Server": {
    "prefix": "opentcpserver",
    "body": [
      "Dim As Integer ${1:server_file} = FreeFile()",
      "If( OPEN TCP SERVER( \"host=${2:127.0.0.1},port=${3:8080},backlog=${4:1}\" As #${1:server_file} ) <> 0 ) Then",
      "    Print \"OPEN TCP SERVER failed, ERR=\"; Err",
      "Else",
      "    ${0}",
      "End If"
    ],
    "description": "Open a listening TCP socket with FreeBASIC's OPEN TCP SERVER syntax"
  },
  "HTTP Server TCP": {
    "prefix": "httpserver",
    "body": [
      "Dim As Integer ${1:server_file} = FreeFile()",
      "Dim As Integer ${2:client_file}",
      "",
      "If( OPEN TCP SERVER( \"host=${3:127.0.0.1},port=${4:8080},backlog=${5:5}\" As #${1:server_file} ) <> 0 ) Then",
      "    Print \"OPEN TCP SERVER failed, ERR=\"; Err",
      "Else",
      "    ${2:client_file} = TCP ACCEPT( #${1:server_file} )",
      "    If( ${2:client_file} <> 0 ) Then",
      "        Print #${2:client_file}, \"HTTP/1.0 200 OK\"",
      "        Print #${2:client_file}, \"Content-Type: text/plain\"",
      "        Print #${2:client_file},",
      "        Print #${2:client_file}, \"Hello from FreeBASIC\"",
      "        Close #${2:client_file}",
      "    End If",
      "    Close #${1:server_file}",
      "    ${0}",
      "End If"
    ],
    "description": "Accept one TCP client and return a simple HTTP response"
  },
  "TCP Accept": {
    "prefix": "tcpaccept",
    "body": [
      "Dim As Integer ${1:client_file}",
      "${1:client_file} = TCP ACCEPT( #${2:server_file} )",
      "If( ${1:client_file} = 0 ) Then",
      "    Print \"TCP ACCEPT failed, ERR=\"; Err",
      "Else",
      "    ${0}",
      "End If"
    ],
    "description": "Accept a client connection from an OPEN TCP SERVER socket"
  },
  "Music Play": {
    "prefix": "musicplay",
    "body": [
      "Dim As String ${1:filename} = \"${2:good-morning-to-all.ogg}\"",
      "Dim As Long ${3:result}",
      "${3:result} = MUSIC PLAY( ${1:filename} )",
      "If( ${3:result} < 0 ) Then",
      "    Print \"MUSIC PLAY failed.\"",
      "Else",
      "    ${0}",
      "    MUSIC STOP",
      "End If"
    ],
    "description": "Start music playback with the MUSIC command family"
  },
  "SFX Load And Play": {
    "prefix": "sfxplay",
    "body": [
      "Dim As String ${1:filename} = \"${2:buzzer.wav}\"",
      "SFX LOAD ${3:1}, ${1:filename}",
      "SFX PLAY ${3:1}",
      "${0}"
    ],
    "description": "Load a short sound effect and play it with SFX"
  },
  "SFX Loop Channel": {
    "prefix": "sfxloopchannel",
    "body": [
      "SFX LOAD ${1:1}, \"${2:buzzer.wav}\"",
      "SFX LOOP ${3:2}, ${1:1}",
      "${0}",
      "SFX STOP CHANNEL, ${3:2}"
    ],
    "description": "Loop a sound effect on a specific channel"
  },
  "SFX Echo Effect": {
    "prefix": "sfxecho",
    "body": [
      "#include once \"sfxlib_effects.bi\"",
      "",
      "If( sfxlib.Echo(${1:0.20}, ${2:0.11}, ${3:0.32}) = 0 ) Then",
      "    ${0}",
      "    sfxlib.EchoReset()",
      "End If"
    ],
    "description": "Enable and reset the bundled sfxlib stereo echo effect"
  },
  "SFX Output Capture": {
    "prefix": "sfxcaptureoutput",
    "body": [
      "#include once \"sfxlib_raw.bi\"",
      "",
      "Dim As String ${1:output_file} = \"${2:capture.wav}\"",
      "If( sfxlib.OutputCaptureStart() = 0 ) Then",
      "    ${0}",
      "    sfxlib.OutputCaptureStop()",
      "    If( sfxlib.OutputCaptureSave(StrPtr(${1:output_file})) <> 0 ) Then",
      "        Print \"Could not save \"; ${1:output_file}",
      "    End If",
      "End If"
    ],
    "description": "Record the final sfxlib mixer output and save it as a WAV file"
  },
  "MIDI Open": {
    "prefix": "midiopen",
    "body": [
      "Dim As Long ${1:result}",
      "${1:result} = MIDI OPEN( ${2:0} )",
      "If( ${1:result} = 0 ) Then",
      "    ${0}",
      "    MIDI CLOSE",
      "End If"
    ],
    "description": "Open a MIDI output device with MIDI OPEN"
  },
  "MIDI Send": {
    "prefix": "midisend",
    "body": [
      "Dim As Long ${1:result}",
      "${1:result} = MIDI OPEN( ${2:0} )",
      "If( ${1:result} = 0 ) Then",
      "    ${1:result} = MIDI SEND( &H90, ${3:60}, ${4:100} )",
      "    Sleep ${5:250}",
      "    ${1:result} = MIDI SEND( &H80, ${3:60}, 0 )",
      "    MIDI CLOSE",
      "    ${0}",
      "End If"
    ],
    "description": "Open a MIDI device and send note-on/note-off messages"
  },
  "Capture Start": {
    "prefix": "capturestart",
    "body": [
      "Dim As Long ${1:result}",
      "${1:result} = CAPTURE START()",
      "If( ${1:result} = 0 ) Then",
      "    ${0}",
      "    CAPTURE STOP",
      "End If"
    ],
    "description": "Start audio capture with the CAPTURE command family"
  },
  "Capture Read": {
    "prefix": "captureread",
    "body": [
      "Dim ${1:buffer}(0 To ${2:1023}) As Single",
      "Dim As Long ${3:available_frames}, ${4:frames_read}",
      "",
      "If( CAPTURE START() = 0 ) Then",
      "    Sleep ${5:400}",
      "    ${3:available_frames} = CAPTURE AVAILABLE()",
      "    If( ${3:available_frames} > ${2:1023} ) Then ${3:available_frames} = ${2:1023}",
      "    If( ${3:available_frames} > 0 ) Then",
      "        ${4:frames_read} = CAPTURE READ( @${1:buffer}(0), ${3:available_frames} )",
      "    End If",
      "    ${0}",
      "    CAPTURE STOP",
      "End If"
    ],
    "description": "Start capture and read available frames into a sample buffer"
  }
}
