{
  "comments": {
    "lineComment": "'",
    "blockComment": [
      "/'",
      "'/"
    ]
  },
  "brackets": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ]
  ],
  "wordPattern": "(?:&[Hh][0-9A-Fa-f]+|&[Bb][01]+|&[Oo][0-7]+|\\d+(?:\\.\\d+)?(?:[EeDd][+-]?\\d+)?)|(?:[A-Za-z_][A-Za-z0-9_]*(?:[$%!#&])?)",
  "indentationRules": {
    "increaseIndentPattern": "(?i)^\\s*(?:#(?:if|ifdef|ifndef|macro)\\b.*|(?:private|public|protected)?\\s*(?:sub|function|property|constructor|destructor|operator|type|union|class|namespace|scope|with|extern)\\b.*|enum\\b.*|if\\b.*\\bthen\\s*(?:'[^\\n]*)?$|for\\b.*|do\\b.*|while\\b.*|select\\s+case\\b.*)(?:\\s*'[^\\n]*)?$",
    "decreaseIndentPattern": "(?i)^\\s*(?:#(?:elif|elseif|elseifdef|elseifndef|else|endif|endmacro)\\b|end\\b(?:\\s+(?:if|select|sub|function|property|constructor|destructor|operator|enum|type|union|class|namespace|extern|scope|with|asm|macro))?|loop\\b|next\\b|wend\\b|else(?:if)?\\b|case\\b)",
    "indentNextLinePattern": "(?i)^\\s*(?:#(?:elif|elseif|elseifdef|elseifndef|else)\\b.*|else(?:if)?\\b.*|case\\b.*)(?:\\s*'[^\\n]*)?$",
    "unIndentedLinePattern": "^\\s*(?:'|$)"
  },
  "autoClosingPairs": [
    {
      "open": "(",
      "close": ")"
    },
    {
      "open": "[",
      "close": "]"
    },
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "string",
        "comment"
      ]
    },
    {
      "open": "/'",
      "close": "'/",
      "notIn": [
        "string",
        "comment"
      ]
    }
  ],
  "surroundingPairs": [
    [
      "(",
      ")"
    ],
    [
      "[",
      "]"
    ],
    [
      "\"",
      "\""
    ],
    [
      "/'",
      "'/"
    ]
  ],
  "folding": {
    "markers": {
      "start": "^\\s*#region\\b",
      "end": "^\\s*#endregion\\b"
    }
  }
}
