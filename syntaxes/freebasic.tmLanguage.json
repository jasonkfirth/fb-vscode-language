{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "FreeBASIC",
  "scopeName": "source.freebasic",
  "patterns": [
    {
      "include": "#comments"
    },
    {
      "include": "#strings"
    },
    {
      "include": "#preprocessor"
    },
    {
      "include": "#labels"
    },
    {
      "include": "#numbers"
    },
    {
      "include": "#declarations"
    },
    {
      "include": "#compoundKeywords"
    },
    {
      "include": "#operators"
    },
    {
      "include": "#types"
    },
    {
      "include": "#constants"
    },
    {
      "include": "#functions"
    },
    {
      "include": "#keywords"
    }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.apostrophe.freebasic",
          "match": "'[^\\n]*"
        },
        {
          "name": "comment.line.rem.freebasic",
          "match": "(?i)\\bREM\\b[^\\n]*"
        },
        {
          "include": "#blockComment"
        }
      ]
    },
    "blockComment": {
      "name": "comment.block.freebasic",
      "begin": "/'",
      "end": "'/",
      "patterns": [
        {
          "include": "#blockComment"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.escape.freebasic",
          "match": "(!)(\")(?:(?:\\\\[^\\r\\n])|[^\"\\\\\\r\\n])*(\")",
          "captures": {
            "1": {
              "name": "storage.modifier.freebasic"
            },
            "2": {
              "name": "punctuation.definition.string.begin.freebasic"
            },
            "3": {
              "name": "punctuation.definition.string.end.freebasic"
            }
          }
        },
        {
          "name": "string.quoted.double.freebasic",
          "match": "([$]?)(\")(?:(?:\"\")|[^\"\\r\\n])*(\")",
          "captures": {
            "1": {
              "name": "storage.modifier.freebasic"
            },
            "2": {
              "name": "punctuation.definition.string.begin.freebasic"
            },
            "3": {
              "name": "punctuation.definition.string.end.freebasic"
            }
          }
        }
      ]
    },
    "preprocessor": {
      "patterns": [
        {
          "name": "meta.preprocessor.freebasic",
          "begin": "(?i)^(\\s*)(#)(DEFINE|MACRO)\\b\\s+([A-Z_][A-Z0-9_]*(?:[$%!#&])?)",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.directive.freebasic"
            },
            "3": {
              "name": "keyword.control.directive.freebasic"
            },
            "4": {
              "name": "entity.name.function.preprocessor.freebasic"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#types"
            },
            {
              "include": "#functions"
            },
            {
              "include": "#keywords"
            }
          ]
        },
        {
          "name": "meta.preprocessor.freebasic",
          "begin": "(?i)^(\\s*)(#)(assert|cmdline|define|dump|else|elseif|elseifdef|elseifndef|endif|endmacro|error|if|ifdef|ifndef|inclib|include|lang|libpath|line|lookup|macro|odump|pragma|print|undef)\\b",
          "beginCaptures": {
            "2": {
              "name": "punctuation.definition.directive.freebasic"
            },
            "3": {
              "name": "keyword.control.directive.freebasic"
            }
          },
          "end": "$",
          "patterns": [
            {
              "include": "#strings"
            },
            {
              "include": "#comments"
            },
            {
              "include": "#numbers"
            },
            {
              "include": "#constants"
            },
            {
              "include": "#operators"
            },
            {
              "include": "#types"
            },
            {
              "include": "#functions"
            },
            {
              "include": "#keywords"
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.freebasic",
          "match": "(?i)(?<![A-Z0-9_])(?:&H[0-9A-F]+|&B[01]+|&O?[0-7]+|(?:\\d+\\.\\d*|\\.\\d+|\\d+)(?:[ED][+-]?\\d+)?)(?:U(?:LL?)?|LL?|F|D|[%!#&])?(?![A-Z0-9_])"
        }
      ]
    },
    "labels": {
      "patterns": [
        {
          "name": "meta.label.freebasic",
          "match": "(?i)^\\s*([A-Z_][A-Z0-9_]*|\\d+)(\\s*:)",
          "captures": {
            "1": {
              "name": "entity.name.label.freebasic"
            },
            "2": {
              "name": "punctuation.separator.label.freebasic"
            }
          }
        }
      ]
    },
    "declarations": {
      "patterns": [
        {
          "name": "meta.declaration.procedure.freebasic",
          "match": "(?i)\\b(SUB|FUNCTION|PROPERTY)\\s+([A-Z_][A-Z0-9_]*(?:[$%!#&])?(?:\\.[A-Z_][A-Z0-9_]*(?:[$%!#&])?)*)",
          "captures": {
            "1": {
              "name": "storage.type.function.freebasic"
            },
            "2": {
              "name": "entity.name.function.freebasic"
            }
          }
        },
        {
          "name": "meta.declaration.type.freebasic",
          "match": "(?i)\\b(TYPE|CLASS|UNION|ENUM)\\s+([A-Z_][A-Z0-9_]*(?:[$%!#&])?)",
          "captures": {
            "1": {
              "name": "storage.type.freebasic"
            },
            "2": {
              "name": "entity.name.type.freebasic"
            }
          }
        },
        {
          "name": "meta.declaration.namespace.freebasic",
          "match": "(?i)\\b(NAMESPACE)\\s+([A-Z_][A-Z0-9_]*(?:\\.[A-Z_][A-Z0-9_]*)*)",
          "captures": {
            "1": {
              "name": "storage.type.namespace.freebasic"
            },
            "2": {
              "name": "entity.name.namespace.freebasic"
            }
          }
        },
        {
          "name": "meta.declaration.constant.freebasic",
          "match": "(?i)\\b(CONST)\\s+(AS)\\s+(?:UNSIGNED\\s+)?[A-Z_][A-Z0-9_.]*(?:\\s+(?:PTR|POINTER))*\\s+([A-Z_][A-Z0-9_]*(?:[$%!#&])?)",
          "captures": {
            "1": {
              "name": "storage.modifier.freebasic"
            },
            "2": {
              "name": "storage.type.freebasic"
            },
            "3": {
              "name": "entity.name.constant.freebasic"
            }
          }
        },
        {
          "name": "meta.declaration.constant.freebasic",
          "match": "(?i)\\b(CONST)\\s+((?!AS\\b)[A-Z_][A-Z0-9_]*(?:[$%!#&])?)",
          "captures": {
            "1": {
              "name": "storage.modifier.freebasic"
            },
            "2": {
              "name": "entity.name.constant.freebasic"
            }
          }
        },
        {
          "name": "meta.declaration.variable.freebasic",
          "match": "(?i)\\b(DIM|REDIM|STATIC|COMMON|EXTERN)\\s+(?:(?:SHARED|STATIC|COMMON|EXTERN|PRESERVE)\\s+)*(AS)\\s+(?:UNSIGNED\\s+)?[A-Z_][A-Z0-9_.]*(?:\\s+(?:PTR|POINTER))*\\s+([A-Z_][A-Z0-9_]*(?:[$%!#&])?)",
          "captures": {
            "1": {
              "name": "storage.modifier.freebasic"
            },
            "2": {
              "name": "storage.type.freebasic"
            },
            "3": {
              "name": "variable.other.readwrite.freebasic"
            }
          }
        },
        {
          "name": "meta.declaration.variable.freebasic",
          "match": "(?i)\\b(DIM|REDIM|STATIC|COMMON|EXTERN|VAR)\\s+(?:(?:SHARED|STATIC|COMMON|EXTERN|PRESERVE)\\s+)*((?!(?:AS|SUB|FUNCTION|PROPERTY|CONSTRUCTOR|DESTRUCTOR|OPERATOR)\\b)[A-Z_][A-Z0-9_]*(?:[$%!#&])?)",
          "captures": {
            "1": {
              "name": "storage.modifier.freebasic"
            },
            "2": {
              "name": "variable.other.readwrite.freebasic"
            }
          }
        },
        {
          "name": "meta.declaration.parameter.freebasic",
          "match": "(?i)\\b(BYVAL|BYREF|BYDESC|PARAMARRAY)\\s+([A-Z_][A-Z0-9_]*(?:[$%!#&])?)",
          "captures": {
            "1": {
              "name": "storage.modifier.freebasic"
            },
            "2": {
              "name": "variable.parameter.freebasic"
            }
          }
        },
        {
          "name": "meta.declaration.loop-variable.freebasic",
          "match": "(?i)\\b(FOR)\\s+([A-Z_][A-Z0-9_]*(?:[$%!#&])?)\\s+(AS)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "variable.other.readwrite.freebasic"
            },
            "3": {
              "name": "storage.type.freebasic"
            }
          }
        }
      ]
    },
    "compoundKeywords": {
      "patterns": [
        {
          "name": "meta.select.case.freebasic",
          "match": "(?i)\\b(SELECT)\\s+(CASE)(?:\\s+(AS)\\s+(CONST))?\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            },
            "3": {
              "name": "keyword.control.freebasic"
            },
            "4": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.case.else.freebasic",
          "match": "(?i)\\b(CASE)\\s+(ELSE)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.end.block.freebasic",
          "match": "(?i)\\b(END)\\s+(IF|SELECT|SUB|FUNCTION|PROPERTY|CONSTRUCTOR|DESTRUCTOR|OPERATOR|ENUM|TYPE|UNION|CLASS|NAMESPACE|EXTERN|SCOPE|WITH|ASM|MACRO)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.exit.block.freebasic",
          "match": "(?i)\\b(EXIT)\\s+(DO|FOR|WHILE|SELECT|SUB|FUNCTION|PROPERTY|CONSTRUCTOR|DESTRUCTOR|OPERATOR)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.continue.block.freebasic",
          "match": "(?i)\\b(CONTINUE)\\s+(DO|FOR|WHILE)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.on.error.freebasic",
          "match": "(?i)\\b(ON)\\s+((?:LOCAL\\s+)?ERROR)\\s+(GOTO|RESUME)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            },
            "3": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.resume.next.freebasic",
          "match": "(?i)\\b(RESUME)\\s+(NEXT)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.option.mode.freebasic",
          "match": "(?i)\\b(OPTION)\\s+(BASE|BYVAL|DYNAMIC|EXPLICIT|ESCAPE|GOSUB|PRIVATE)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.line.input.freebasic",
          "match": "(?i)\\b(LINE)\\s+(INPUT)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.view.print.freebasic",
          "match": "(?i)\\b(VIEW)\\s+(PRINT)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.view.screen.freebasic",
          "match": "(?i)\\b(VIEW)\\s+(SCREEN)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.draw.string.freebasic",
          "match": "(?i)\\b(DRAW)\\s+(STRING)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "support.function.freebasic"
            }
          }
        },
        {
          "name": "meta.palette.command.freebasic",
          "match": "(?i)\\b(PALETTE)\\s+(GET)(?:\\s+(USING))?\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "support.function.freebasic"
            },
            "3": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.palette.command.freebasic",
          "match": "(?i)\\b(PALETTE)\\s+(USING)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.open.device.freebasic",
          "match": "(?i)\\b(OPEN)\\s+(CONS|ERR|PIPE|SCRN|LPT|COM|TCP)(?:\\s+(SERVER))?\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            },
            "3": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.tcp.accept.freebasic",
          "match": "(?i)\\b(TCP)\\s+(ACCEPT)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "support.function.freebasic"
            }
          }
        },
        {
          "name": "meta.width.lprint.freebasic",
          "match": "(?i)\\b(WIDTH)\\s+(LPRINT)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.music.command.freebasic",
          "match": "(?i)\\b(MUSIC)\\s+(LOAD|PLAY|LOOP|STOP|PAUSE|RESUME|STATUS|POSITION)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "support.function.freebasic"
            }
          }
        },
        {
          "name": "meta.sfx.status.channel.freebasic",
          "match": "(?i)\\b(SFX)\\s+(STATUS)\\s*(\\()?\\s*(CHANNEL)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "support.function.freebasic"
            },
            "3": {
              "name": "punctuation.section.group.begin.freebasic"
            },
            "4": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.sfx.channel-command.freebasic",
          "match": "(?i)\\b(SFX)\\s+(STOP|PAUSE|RESUME)\\s+(CHANNEL)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "support.function.freebasic"
            },
            "3": {
              "name": "keyword.control.freebasic"
            }
          }
        },
        {
          "name": "meta.sfx.command.freebasic",
          "match": "(?i)\\b(SFX)\\s+(LOAD|PLAY|LOOP|STOP|PAUSE|RESUME|STATUS)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "support.function.freebasic"
            }
          }
        },
        {
          "name": "meta.midi.command.freebasic",
          "match": "(?i)\\b(MIDI)\\s+(OPEN|CLOSE|PLAY|STOP|PAUSE|RESUME|SEND)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "support.function.freebasic"
            }
          }
        },
        {
          "name": "meta.device.command.freebasic",
          "match": "(?i)\\b(DEVICE)\\s+(LIST|SELECT|INFO)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "support.function.freebasic"
            }
          }
        },
        {
          "name": "meta.capture.command.freebasic",
          "match": "(?i)\\b(CAPTURE)\\s+(START|STOP|PAUSE|RESUME|STATUS|SAVE|AVAILABLE|READ)\\b",
          "captures": {
            "1": {
              "name": "keyword.control.freebasic"
            },
            "2": {
              "name": "support.function.freebasic"
            }
          }
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.word.freebasic",
          "match": "(?i)\\b(?:AND|ANDALSO|DELETE|EQV|IMP|IS|MOD|NEW|NOT|OR|ORELSE|SHL|SHR|XOR)\\b"
        },
        {
          "name": "keyword.operator.symbolic.freebasic",
          "match": "(?:->|<>|<=|>=|=>|=<|[-+*/\\\\^=<>@&])"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "storage.type.freebasic",
          "match": "(?i)\\b(?:__CVA_LIST|__FB_BUILTIN_BOOL|__FB_BUILTIN_CLONG|__FB_BUILTIN_CULONG|__FB_BUILTIN_SIZE_T|_OLD_HEADER|ANY|BOOLEAN|BYTE|COMSTATUS|CVA_LIST|DOUBLE|EVENT|GFX3POINT|GFX3RENDERCALLBACK|IMAGE|INTEGER|LONG|LONGINT|OBJECT|PUT_HEADER|SHORT|SINGLE|STRING|UBYTE|UINTEGER|ULONG|ULONGINT|UNSIGNED|USHORT|USTRING|WSTRING|ZSTRING)\\b"
        },
        {
          "name": "storage.modifier.freebasic",
          "match": "(?i)\\b(?:POINTER|PTR)\\b"
        }
      ]
    },
    "constants": {
      "patterns": [
        {
          "name": "constant.language.freebasic",
          "match": "(?i)\\b(?:__CMDLINE__|__DATE__|__DATE_ISO__|__FB_64BIT__|__FB_AMIGA__|__FB_ANDROID__|__FB_ARCH__|__FB_ARG_COUNT__|__FB_ARG_EXTRACT__|__FB_ARG_LEFTOF__|__FB_ARG_LISTEXPAND__|__FB_ARG_RIGHTOF__|__FB_ARM__|__FB_AROS__|__FB_ASM__|__FB_BACKEND__|__FB_BIGENDIAN__|__FB_BUILD_DATE__|__FB_BUILD_DATE_ISO__|__FB_BUILD_FORK_ID__|__FB_BUILD_SHA1__|__FB_CYGWIN__|__FB_DARWIN__|__FB_DEBUG__|__FB_DOS__|__FB_DRAGONFLY__|__FB_ENTRY__|__FB_ERR__|__FB_EVAL__|__FB_EXPORT__|__FB_FPMODE__|__FB_FPU__|__FB_FREEBSD__|__FB_GCC__|__FB_GFXLIB3__|__FB_GOSUB_SETJMP__|__FB_GUI__|__FB_HAIKU__|__FB_HAS_USTRING__|__FB_IIF__|__FB_ILLUMOS__|__FB_JOIN__|__FB_JS__|__FB_LANG__|__FB_LINUX__|__FB_LOONGARCH64__|__FB_M68K__|__FB_MAIN__|__FB_MIN_VERSION__|__FB_MIPS__|__FB_MIPS32__|__FB_MIPS64__|__FB_MT__|__FB_NETBSD__|__FB_NO_FASTCALL__|__FB_NO_THISCALL__|__FB_NOBUILTINS__|__FB_NOCMDLINE__|__FB_NUTTX__|__FB_OPENBSD__|__FB_OPTABSTRACT__|__FB_OPTIMIZE__|__FB_OPTION_BYVAL__|__FB_OPTION_DYNAMIC__|__FB_OPTION_ESCAPE__|__FB_OPTION_EXPLICIT__|__FB_OPTION_GOSUB__|__FB_OPTION_PRIVATE__|__FB_OPTION_PROFILE__|__FB_OUT_DLL__|__FB_OUT_EXE__|__FB_OUT_LIB__|__FB_OUT_OBJ__|__FB_PCOS__|__FB_PIC__|__FB_PPC__|__FB_PROFILE__|__FB_QUERY_SYMBOL__|__FB_QUOTE__|__FB_RETURN_IN_FLTS__|__FB_RISCOS__|__FB_RISCV32__|__FB_RISCV64__|__FB_S390X__|__FB_SIGNATURE__|__FB_SOLARIS__|__FB_SSE__|__FB_UNIQUEID__|__FB_UNIQUEID_POP__|__FB_UNIQUEID_PUSH__|__FB_UNIX__|__FB_UNQUOTE__|__FB_VALIST_AS_PTR__|__FB_VECTORIZE__|__FB_VER_MAJOR__|__FB_VER_MINOR__|__FB_VER_PATCH__|__FB_VERBOSE__|__FB_VERSION__|__FB_WII__|__FB_WIN32__|__FB_WINCE__|__FB_X86__|__FB_XBOX__|__FILE__|__FILE_NQ__|__FUNCTION__|__FUNCTION_NQ__|__LINE__|__PATH__|__TIME__|FALSE|FB_NO_GFXLIB|FB_NO_SFXLIB|FB_NO_USTRING|NULL|TRUE)\\b|__(?:[A-Z0-9_]+)__"
        },
