{
    "$schema":  "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
    "name":  "FreeBASIC",
    "scopeName":  "source.freebasic",
    "patterns":  [
                     {
                         "include":  "#comments"
                     },
                     {
                         "include":  "#strings"
                     },
                     {
                         "include":  "#preprocessor"
                     },
                     {
                         "include":  "#numbers"
                     },
                     {
                         "include":  "#labels"
                     },
                     {
                         "include":  "#compoundKeywords"
                     },
                     {
                         "include":  "#operators"
                     },
                     {
                         "include":  "#types"
                     },
                     {
                         "include":  "#constants"
                     },
                     {
                         "include":  "#functions"
                     },
                     {
                         "include":  "#keywords"
                     }
                 ],
    "repository":  {
                       "comments":  {
                                        "patterns":  [
                                                         {
                                                             "name":  "comment.line.apostrophe.freebasic",
                                                             "match":  "\u0027[^\\n]*"
                                                         },
                                                         {
                                                             "name":  "comment.line.rem.freebasic",
                                                             "match":  "(?i)\\bREM\\b[^\\n]*"
                                                         },
                                                         {
                                                             "name":  "comment.block.freebasic",
                                                             "begin":  "/\u0027",
                                                             "end":  "\u0027/"
                                                         }
                                                     ]
                                    },
                       "strings":  {
                                       "patterns":  [
                                                        {
                                                            "name":  "string.quoted.double.freebasic",
                                                            "match":  "([!$]?)(\")(?:(?:\"\")|[^\"\\r\\n])*(\")",
                                                            "captures":  {
                                                                             "1":  {
                                                                                       "name":  "storage.modifier.freebasic"
                                                                                   },
                                                                             "2":  {
                                                                                       "name":  "punctuation.definition.string.begin.freebasic"
                                                                                   },
                                                                             "3":  {
                                                                                       "name":  "punctuation.definition.string.end.freebasic"
                                                                                   }
                                                                         }
                                                        }
                                                    ]
                                   },
                       "preprocessor":  {
                                            "patterns":  [
                                                             {
                                                                 "name":  "meta.preprocessor.freebasic",
                                                                 "match":  "(?i)^\\s*#(?:assert|cmdline|define|elif|else|elseif|elseifdef|elseifndef|endif|endmacro|error|if|ifdef|ifndef|inclib|include(?:\\s+once)?|lang|libpath|macro|pragma|print|undef)\\b.*$"
                                                             }
                                                         ]
                                        },
                       "numbers":  {
                                       "patterns":  [
                                                        {
                                                            "name":  "constant.numeric.freebasic",
                                                            "match":  "(?i)\\b(?:\u0026H[0-9A-F]+|\u0026B[01]+|\u0026O[0-7]+|\\d+(?:\\.\\d+)?(?:[ED][+-]?\\d+)?)\\b"
                                                        }
                                                    ]
                                   },
                       "labels":  {
                                      "patterns":  [
                                                       {
                                                           "name":  "meta.label.freebasic",
                                                           "match":  "(?i)^\\s*([A-Z_][A-Z0-9_]*|\\d+)(\\s*:)",
                                                           "captures":  {
                                                                            "1":  {
                                                                                      "name":  "entity.name.label.freebasic"
                                                                                  },
                                                                            "2":  {
                                                                                      "name":  "punctuation.separator.label.freebasic"
                                                                                  }
                                                                        }
                                                       }
                                                   ]
                                  },
                       "compoundKeywords":  {
                                                "patterns":  [
                                                                 {
                                                                     "name":  "meta.select.case.freebasic",
                                                                     "match":  "(?i)\\b(SELECT)\\s+(CASE)(?:\\s+(AS)\\s+(CONST))?\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "3":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "4":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.case.else.freebasic",
                                                                     "match":  "(?i)\\b(CASE)\\s+(ELSE)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.end.block.freebasic",
                                                                     "match":  "(?i)\\b(END)\\s+(IF|SELECT|SUB|FUNCTION|PROPERTY|CONSTRUCTOR|DESTRUCTOR|OPERATOR|ENUM|TYPE|UNION|CLASS|NAMESPACE|EXTERN|SCOPE|WITH|ASM|MACRO)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.exit.block.freebasic",
                                                                     "match":  "(?i)\\b(EXIT)\\s+(DO|FOR|WHILE|SELECT|SUB|FUNCTION|PROPERTY|CONSTRUCTOR|DESTRUCTOR|OPERATOR)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.continue.block.freebasic",
                                                                     "match":  "(?i)\\b(CONTINUE)\\s+(DO|FOR|WHILE)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.on.error.freebasic",
                                                                     "match":  "(?i)\\b(ON)\\s+((?:LOCAL\\s+)?ERROR)\\s+(GOTO|RESUME)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "3":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.resume.next.freebasic",
                                                                     "match":  "(?i)\\b(RESUME)\\s+(NEXT)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.option.mode.freebasic",
                                                                     "match":  "(?i)\\b(OPTION)\\s+(BASE|BYVAL|DYNAMIC|EXPLICIT|ESCAPE|GOSUB|PRIVATE)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.line.input.freebasic",
                                                                     "match":  "(?i)\\b(LINE)\\s+(INPUT)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.view.print.freebasic",
                                                                     "match":  "(?i)\\b(VIEW)\\s+(PRINT)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.view.screen.freebasic",
                                                                     "match":  "(?i)\\b(VIEW)\\s+(SCREEN)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.draw.string.freebasic",
                                                                     "match":  "(?i)\\b(DRAW)\\s+(STRING)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.palette.command.freebasic",
                                                                     "match":  "(?i)\\b(PALETTE)\\s+(GET)(?:\\s+(USING))?\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            },
                                                                                      "3":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.palette.command.freebasic",
                                                                     "match":  "(?i)\\b(PALETTE)\\s+(USING)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.open.device.freebasic",
                                                                     "match":  "(?i)\\b(OPEN)\\s+(CONS|ERR|PIPE|SCRN|LPT|COM|TCP)(?:\\s+(SERVER))?\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "3":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.tcp.accept.freebasic",
                                                                     "match":  "(?i)\\b(TCP)\\s+(ACCEPT)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.width.lprint.freebasic",
                                                                     "match":  "(?i)\\b(WIDTH)\\s+(LPRINT)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.music.command.freebasic",
                                                                     "match":  "(?i)\\b(MUSIC)\\s+(LOAD|PLAY|LOOP|STOP|PAUSE|RESUME|STATUS|CURRENT|POSITION)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.sfx.status.channel.freebasic",
                                                                     "match":  "(?i)\\b(SFX)\\s+(STATUS)\\s*(\\()?\\s*(CHANNEL)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            },
                                                                                      "3":  {
                                                                                                "name":  "punctuation.section.group.begin.freebasic"
                                                                                            },
                                                                                      "4":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.sfx.channel-command.freebasic",
                                                                     "match":  "(?i)\\b(SFX)\\s+(STOP|PAUSE|RESUME)\\s+(CHANNEL)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            },
                                                                                      "3":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.sfx.command.freebasic",
                                                                     "match":  "(?i)\\b(SFX)\\s+(LOAD|PLAY|LOOP|STOP|PAUSE|RESUME|STATUS)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.audio.command.freebasic",
                                                                     "match":  "(?i)\\b(AUDIO)\\s+(PLAY|LOOP|STOP|PAUSE|RESUME|STATUS)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.stream.command.freebasic",
                                                                     "match":  "(?i)\\b(STREAM)\\s+(OPEN|PLAY|STOP|PAUSE|RESUME|POSITION|SEEK)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.midi.command.freebasic",
                                                                     "match":  "(?i)\\b(MIDI)\\s+(OPEN|CLOSE|PLAY|STOP|PAUSE|RESUME|SEND)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.device.command.freebasic",
                                                                     "match":  "(?i)\\b(DEVICE)\\s+(LIST|SELECT|INFO)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            }
                                                                                  }
                                                                 },
                                                                 {
                                                                     "name":  "meta.capture.command.freebasic",
                                                                     "match":  "(?i)\\b(CAPTURE)\\s+(START|STOP|PAUSE|RESUME|STATUS|SAVE|AVAILABLE|READ)\\b",
                                                                     "captures":  {
                                                                                      "1":  {
                                                                                                "name":  "keyword.control.freebasic"
                                                                                            },
                                                                                      "2":  {
                                                                                                "name":  "support.function.freebasic"
                                                                                            }
                                                                                  }
                                                                 }
                                                             ]
                                            },
                       "operators":  {
                                         "patterns":  [
                                                          {
                                                              "name":  "keyword.operator.word.freebasic",
                                                              "match":  "(?i)\\b(?:AND|ANDALSO|DELETE|EQV|IMP|IS|MOD|NEW|NOT|OR|ORELSE|SHL|SHR|XOR)\\b"
                                                          }
                                                      ]
                                     },
                       "types":  {
                                     "patterns":  [
                                                      {
                                                          "name":  "storage.type.freebasic",
                                                          "match":  "(?i)\\b(?:__CVA_LIST|ANY|BOOLEAN|BYTE|CVA_LIST|DOUBLE|INTEGER|LONG|LONGINT|OBJECT|SHORT|SINGLE|STRING|UBYTE|UINTEGER|ULONG|ULONGINT|UNSIGNED|USHORT|WSTRING|ZSTRING)\\b"
                                                      },
                                                      {
                                                          "name":  "storage.modifier.freebasic",
                                                          "match":  "(?i)\\b(?:POINTER|PTR)\\b"
                                                      }
                                                  ]
                                 },
                       "constants":  {
                                         "patterns":  [
                                                          {
                                                              "name":  "constant.language.freebasic",
                                                              "match":  "(?i)\\b(?:FALSE|NULL|TRUE)\\b|__(?:[A-Z0-9_]+)__"
                                                          },
                                                          {
                                                              "name":  "constant.other.freebasic",
                                                              "match":  "(?i)(?\u003c![A-Za-z0-9_\\.])(?:BUTTON_LEFT|BUTTON_RIGHT|EVENT_KEY_PRESS|EVENT_KEY_RELEASE|EVENT_KEY_REPEAT|EVENT_MOUSE_BUTTON_PRESS|EVENT_MOUSE_BUTTON_RELEASE|EVENT_MOUSE_DOUBLE_CLICK|EVENT_MOUSE_ENTER|EVENT_MOUSE_EXIT|EVENT_MOUSE_MOVE|EVENT_MOUSE_WHEEL|EVENT_WINDOW_CLOSE|EVENT_WINDOW_GOT_FOCUS|EVENT_WINDOW_LOST_FOCUS|FB\\.EVENT_MOUSE_HWHEEL|FB\\.GET_SCREEN_SIZE|FB\\.GFX_OPENGL|FB\\.PUT_HEADER|FB_IMAGE|FB_ISR_GET|FB_ISR_RESET|FB_ISR_SET|FB_MEMCOPY|GFX_NULL|SC_ESCAPE|SC_INDEX)(?![A-Za-z0-9_])"
                                                          }
                                                      ]
                                     },
                       "functions":  {
                                         "patterns":  [
                                                          {
                                                              "name":  "support.function.freebasic",
                                                              "match":  "(?i)\\b(?:__ASSERT|__ASSERTWARN|__BIT|__BITRESET|__BITSET|__HIBYTE|__HIWORD|__LOBYTE|__LOWORD|__OFFSETOF|__RGB|__RGBA|__VA_ARG|__VA_NEXT|ABS|ACOS|ACOSF|ASC|ASIN|ASINF|ASSERT|ASSERTWARN|ATAN|ATAN2|ATAN2F|ATANF|ATN|BIN|BIT|BITRESET|BITSET|CAST|CBOOL|CBYTE|CDBL|CHR|CINT|CLNG|CLNGINT|COS|CPTR|CSHORT|CSIGN|CSNG|CUBYTE|CUINT|CULNG|CULNGINT|CUNSG|CUSHORT|CVA_ARG|CVA_COPY|CVA_END|CVA_START|CVD|CVI|CVL|CVLONGINT|CVS|CVSHORT|DEFINED|ERFN|ERR|EXP|FABS|FABSF|FIX|FRAC|HEX|HIBYTE|HIWORD|IIF|INSTR|INSTRREV|INT|LBOUND|LCASE|LEFT|LEN|LLABS|LOBYTE|LOG|LOWORD|LTRIM|MID|MKD|MKI|MKL|MKLONGINT|MKS|MKSHORT|OCT|OFFSETOF|PEEK|POINT|POKE|POW|RIGHT|RTRIM|SADD|SGN|SIN|SIZEOF|SPACE|SPC|SQR|STR|STRPTR|SWAP|TAB|TAN|TANF|TRIM|TYPEOF|UBOUND|UCASE|VA_ARG|VA_FIRST|VA_NEXT|VAL|VALINT|VALLNG|VALUINT|VALULNG|VARPTR|WBIN|WCHR|WHEX|WOCT|WSPACE|WSTR)\\b"
                                                          },
                                                          {
                                                              "name":  "support.function.freebasic",
                                                              "match":  "(?i)\\b(?:ALLOCATE|ATEXIT|BEEP|CALLOCATE|CHAIN|CHANNEL|CHDIR|CLEAR|CLS|COMMAND|CONDBROADCAST|CONDCREATE|CONDDESTROY|CONDSIGNAL|CONDWAIT|CSRLIN|CURDIR|DATE|DEALLOCATE|DIR|DYLIBFREE|DYLIBLOAD|DYLIBSYMBOL|ENVIRON|EOC|EOF|ERL|ERMN|EXEC|EXEPATH|FRE|FREEFILE|GETKEY|INKEY|INP|KILL|LOC|LOCATE|LOF|LPOS|MEMCPY|MEMMOVE|MKDIR|MUTEXCREATE|MUTEXDESTROY|MUTEXLOCK|MUTEXUNLOCK|OUT|POS|RANDOMIZE|REALLOCATE|RENAME|RESET|RMDIR|RND|RUN|SETDATE|SETENVIRON|SETTIME|SHELL|SLEEP|STOP|SYSTEM|THREADCREATE|THREADWAIT|TIME|TIMER|WAIT)\\b"
                                                          },
                                                          {
                                                              "name":  "support.function.freebasic",
                                                              "match":  "(?i)\\b(?:BALANCE|BLOAD|BSAVE|ENVELOPE|FLIP|GETJOYSTICK|GETMOUSE|IMAGECONVERTROW|IMAGECREATE|IMAGEDESTROY|IMAGEINFO|INSTRUMENT|MULTIKEY|NOISE|NOTE|OCTAVE|PAN|PCOPY|PLAY|PMAP|POINTCOORD|REST|RGB|RGBA|SCREENCONTROL|SCREENCOPY|SCREENEVENT|SCREENGLPROC|SCREENINFO|SCREENLIST|SCREENLOCK|SCREENPTR|SCREENRES|SCREENSET|SCREENSYNC|SCREENUNLOCK|SETMOUSE|SOUND|STICK|STRIG|TEMPO|TONE|VOICE|VOLUME|WAVE|WINDOWTITLE)\\b"
                                                          }
                                                      ]
                                     },
                       "keywords":  {
                                        "patterns":  [
                                                         {
                                                             "name":  "keyword.control.freebasic",
                                                             "match":  "(?i)\\b(?:__FASTCALL|__THISCALL|ABSTRACT|ACCESS|ALIAS|APPEND|AS|ASM|AUDIO|BASE|BINARY|BYREF|BYVAL|CALL|CAPTURE|CASE|CDECL|CIRCLE|CLASS|CLOSE|COLOR|COM|COMMON|CONS|CONST|CONSTRUCTOR|CONTINUE|DATA|DECLARE|DEFBYTE|DEFDBL|DEFINT|DEFLNG|DEFLONGINT|DEFSHORT|DEFSNG|DEFSTR|DEFUBYTE|DEFUINT|DEFULNG|DEFULONGINT|DEFUSHORT|DESTRUCTOR|DEVICE|DIM|DO|DRAW|DYNAMIC|ELSE|ELSEIF|ENCODING|END|ENDIF|ENUM|ERASE|ERROR|EXIT|EXPLICIT|EXPORT|EXTENDS|EXTERN|FIELD|FOR|FUNCTION|GET|GOSUB|GOTO|IF|IMPLEMENTS|IMPORT|INCLUDE|INPUT|LET|LIB|LINE|LOCAL|LOCK|LOOP|LPRINT|LSET|MIDI|MUSIC|NAME|NAMESPACE|NEXT|ON|OPEN|OPERATOR|OPTION|OUTPUT|OVERLOAD|PAINT|PALETTE|PASCAL|PRESERVE|PRESET|PRINT|PRIVATE|PROCPTR|PROPERTY|PROTECTED|PSET|PUBLIC|PUT|RANDOM|READ|REDIM|RESTORE|RESUME|RETURN|RSET|SCOPE|SCREEN|SEEK|SELECT|SERVER|SFX|SHARED|STATIC|STDCALL|STEP|STREAM|SUB|TCP|THEN|THREADCALL|TO|TYPE|UNION|UNLOCK|UNTIL|USING|VAR|VIEW|VIRTUAL|WEND|WHILE|WIDTH|WINDOW|WINPUT|WITH|WRITE)\\b"
                                                         }
                                                     ]
                                    }
                   }
}
